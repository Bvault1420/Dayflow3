--- /dev/null
+++ b/backend/tests/clientIp.test.js
@@ -0,0 +1,22 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { getClientIp } from '../utils/clientIp.js';
+
+describe('client ip', () => {
+  test('uses the proxy-resolved address, not a spoofed forwarded header', () => {
+    const req = {
+      headers: { 'x-forwarded-for': '8.8.8.8, 203.0.113.10' },
+      ip: '203.0.113.10',
+      socket: { remoteAddress: '10.0.0.1' },
+    };
+    assert.equal(getClientIp(req), '203.0.113.10');
+  });
+
+  test('strips the IPv4-mapped IPv6 prefix', () => {
+    assert.equal(getClientIp({ ip: '::ffff:192.0.2.5' }), '192.0.2.5');
+  });
+
+  test('falls back when no address is known', () => {
+    assert.equal(getClientIp({}), 'unknown');
+  });
+});
