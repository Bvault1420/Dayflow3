diff --git a/backend/tests/publicPages.test.js b/backend/tests/publicPages.test.js
new file mode 100644
index 0000000..0eff131
--- /dev/null
+++ b/backend/tests/publicPages.test.js
@@ -0,0 +1,59 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+import { LEGAL_SLUGS, renderLegalDocumentHtml } from '../../frontend/src/legalDocuments.js';
+import { PERMISSIONS_POLICY } from '../middleware/security.js';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
+
+describe('crawlable public pages', () => {
+  test('legal routes render real headings and no retired ODR link', () => {
+    for (const slug of LEGAL_SLUGS) {
+      const html = renderLegalDocumentHtml(slug);
+      assert.equal(typeof html, 'string');
+      assert.match(html, /<h1>/);
+      assert.match(html, /lang="de"/);
+      assert.match(html, new RegExp(`href="/${slug}"`));
+      assert.doesNotMatch(html, /consumers\/odr/i);
+      assert.doesNotMatch(html, /fonts\.googleapis\.com/);
+    }
+    assert.match(renderLegalDocumentHtml('impressum'), /Impressum/);
+    assert.match(renderLegalDocumentHtml('datenschutz'), /Datenschutzerklärung/);
+    assert.match(renderLegalDocumentHtml('agb'), /Allgemeine Geschäftsbedingungen/);
+    assert.match(renderLegalDocumentHtml('widerruf'), /Widerrufsbelehrung/);
+    assert.match(renderLegalDocumentHtml('ki-richtlinie'), /KI-Richtlinie/);
+  });
+
+  test('homepage shell is crawlable without Google Fonts', () => {
+    const html = fs.readFileSync(path.join(root, 'frontend/index.html'), 'utf8');
+    assert.match(html, /<h1>/);
+    assert.match(html, /href="\/impressum"/);
+    assert.match(html, /href="\/datenschutz"/);
+    assert.match(html, /href="\/agb"/);
+    assert.match(html, /id="cookie-reject"/);
+    assert.match(html, /id="cookie-accept"/);
+    assert.match(html, /property="og:title"/);
+    assert.match(html, /rel="canonical"/);
+    assert.match(html, /application\/ld\+json/);
+    assert.match(html, /Zum Inhalt springen/);
+    assert.doesNotMatch(html, /fonts\.googleapis\.com|fonts\.gstatic\.com/);
+  });
+
+  test('permissions policy disables unused sensors', () => {
+    assert.match(PERMISSIONS_POLICY, /camera=\(\)/);
+    assert.match(PERMISSIONS_POLICY, /microphone=\(\)/);
+    assert.match(PERMISSIONS_POLICY, /geolocation=\(\)/);
+  });
+
+  test('robots, sitemap and WARD policy exist', () => {
+    const robots = fs.readFileSync(path.join(root, 'frontend/public/robots.txt'), 'utf8');
+    const sitemap = fs.readFileSync(path.join(root, 'frontend/public/sitemap.xml'), 'utf8');
+    const ward = JSON.parse(fs.readFileSync(path.join(root, 'frontend/public/.well-known/ward.json'), 'utf8'));
+    assert.match(robots, /Sitemap:/);
+    assert.match(sitemap, /impressum/);
+    assert.equal(ward.version, '1.0');
+    assert.equal(ward.default.training, false);
+  });
+});
