@@ -1,8 +1,11 @@
-/** Client-IP hinter Reverse-Proxy (trust proxy muss gesetzt sein). */
+/**
+ * Client-IP für Limits und Admin-Freigaben.
+ * Nur req.ip verwenden. Express setzt das über `trust proxy` aus dem
+ * letzten vertrauenswürdigen Hop. Den rohen X-Forwarded-For-Header
+ * nicht selbst lesen: der linke Wert kann vom Aufrufer gesetzt sein
+ * und damit das Rechnungslimit und die Admin-IP-Liste umgehen.
+ */
 export function getClientIp(req) {
-  const forwarded = req.headers['x-forwarded-for'];
-  if (typeof forwarded === 'string' && forwarded.trim()) {
-    return forwarded.split(',')[0].trim().slice(0, 45);
-  }
-  return (req.ip || req.socket?.remoteAddress || 'unknown').slice(0, 45);
+  const raw = req?.ip || req?.socket?.remoteAddress || 'unknown';
+  return String(raw).replace(/^::ffff:/, '').slice(0, 45);
 }
